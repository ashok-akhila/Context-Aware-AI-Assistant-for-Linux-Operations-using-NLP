# Copy this file to .env and fill in your real key.
# Get a free OpenRouter API key at: https://openrouter.ai/keys

OPENROUTER_API_KEY=your_key_here

# Any model from https://openrouter.ai/models?q=free — free ones end in ":free"
OPENROUTER_MODEL=openrouter/free

# Optional: comma-separated fallbacks tried if the primary is rate limited/unavailable.
# Leave empty for none (the old :free gemma/mistral models now return 404).
OPENROUTER_FALLBACK_MODELS=

# 0 = production mode (no debug reloader), 1 = development mode
FLASK_DEBUG=1
